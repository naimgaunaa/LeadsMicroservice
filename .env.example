#---Database---#
DATABASE_URL = "postgresql://username:password@localhost:5432/database_name"

#---frontend---#
FRONTEND_LIST = ["http://localhost:5173"]

#---services---#
CLIENT_MICROSERVICE = "http://localhost:1000"
VEHICLE_MICROSERVICE = "http://localhost:1001"

#---clientes (alta de clientes desde leads)---#
# Fuera de Docker usar http://localhost:8082; en Docker http://host.docker.internal:8082
CLIENTES_URL = "http://localhost:8082"
# Misma clave configurada en el microservicio de clientes (header X-Api-Key)
CLIENTES_CLAVE_LEADS = "cambiar-por-la-clave-real"
# Si CLIENTES_URL apunta al orquestador (http://localhost:8080/api): la clave de "leads" en
# CLAVES_SERVICIO del orquestador (32+ caracteres). Si se llama a clientes directo, dejar vacía.
ORQUESTADOR_CLAVE_SERVICIO = ""

#---API---#
BCRA_API = "api.bcra.gob.ar"

#---kafka---#
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Los tres tópicos del ecosistema (los mismos nombres en todos los servicios).
KAFKA_TOPICO_COMANDOS=crm.comandos
KAFKA_TOPICO_EVENTOS=crm.eventos
KAFKA_TOPICO_DLT=crm.dlt
KAFKA_CONSUMER_GROUP=leads-service
KAFKA_CLIENT_ID=leads-microservice