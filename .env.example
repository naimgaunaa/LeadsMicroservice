#---Database---#
DATABASE_URL = "postgresql://username:password@localhost:5432/database_name"

#---frontend---#
FRONTEND_LIST = ["http://localhost:5173"]

#---services---#
CLIENT_MICROSERVICE = "http://localhost:1000"
VEHICLE_MICROSERVICE = "http://localhost:1001"

#---clientes (alta de clientes desde leads)---#
# Fuera de Docker usar http://localhost:8082; en Docker http://host.docker.internal:8082
CLIENTES_URL = "http://localhost:8082"
# Misma clave configurada en el microservicio de clientes (header X-Api-Key)
CLIENTES_CLAVE_LEADS = "cambiar-por-la-clave-real"

#---API---#
BCRA_API = "api.bcra.gob.ar"

#---kafka---#
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_PREFORMULARIO_COMPLETADO=preformulario-completado
KAFKA_TOPIC_LEAD_CALIFICADO=lead-calificado
KAFKA_CONSUMER_GROUP=leads-service
KAFKA_CLIENT_ID=leads-microservice