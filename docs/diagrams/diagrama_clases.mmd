classDiagram
    %% --- Catálogos y enumeraciones ---
    class NivelCalificacion {
        <<enumeration>>
        NO_POTABLE
        POTABLE
        MUY_POTABLE
    }
    class NombreEstados{
        <<enumeration>>
        PENDIENTE
        CALIFICADO
        EN_GESTION
        DERIVADO
        DESCARTADO
    }

    class EstadoLead {
        <<interface>>
        +calificar()
        +tomar()
        +derivar()
        +descartar()
        +getEstado()
    }

    class Pendiente { }
    class Calificado { }
    class EnGestion { }
    class Derivado { }
    class Descartado { }

    %% --- Patrón State ---
    EstadoLead <|-- Pendiente
    EstadoLead <|-- Calificado
    EstadoLead <|-- EnGestion
    EstadoLead <|-- Derivado
    EstadoLead <|-- Descartado

    Pendiente ..> Calificado
    Calificado ..> EnGestion
    Calificado ..> Descartado
    EnGestion ..> Derivado
    EnGestion ..> Descartado

    %% --- Entidades de negocio del servicio leads ---
    class Permuta {
        +String descripcion
        +float valorDeclarado
        +boolean computable
    }

    class Lead {
        +UUID id
        +UUID clienteId
        +UUID vehiculoId
        +float anticipo
        +boolean solicitaFinanciacion
        +boolean fichaCompleta
        +int puntaje
        +NivelCalificacion nivel
        +EstadoLead estado
        +String provincia
        +String localidad
        +Permuta permuta
        +DateTime creadoEn
    }

    %% --- Relaciones ---
    Lead *-- "0..1" Permuta : "puede incluir"
    Lead "1" --> "1" EstadoLead : "tiene estado"
    Lead "1" --> "0..1" NivelCalificacion : "recibe calificacion"
    EstadoLead ..> NombreEstados : "utiliza"
